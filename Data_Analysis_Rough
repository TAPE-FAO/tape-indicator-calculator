#' FIX 16: similarity of rows that share a questionnaire_ID.
#' Returns, per row, the highest share of identical answers with another row of
#' the same ID (NA when the ID is unique). Metadata columns are ignored.
#' ~0.9+ = almost certainly the same interview submitted twice; ~0.3-0.6 = two
#' different households that were given the same ID by mistake (keep both, but
#' do not use the ID as a key).
flag_duplicate_ids <- function(df, id_col = "questionnaire_ID") {
  ids  <- as.character(df[[id_col]])
  isdup <- !is.na(ids) & (duplicated(ids) | duplicated(ids, fromLast = TRUE))
  sim  <- rep(NA_real_, nrow(df))
  skip <- grepl("^_", names(df)) | grepl("^kobo_", names(df)) |
    names(df) %in% c("start", "end", "today", "datacollection_date", "rootUuid", "instanceID")
  core <- as.data.frame(lapply(df[, !skip, drop = FALSE], as.character), stringsAsFactors = FALSE)
  for (g in unique(ids[isdup])) {
    rows <- which(ids == g)
    for (i in rows) {
      a <- unlist(core[i, ], use.names = FALSE)
      best <- NA_real_
      for (j in setdiff(rows, i)) {
        b  <- unlist(core[j, ], use.names = FALSE)
        ok <- !is.na(a)
        s  <- mean(a[ok] == b[ok] & !is.na(b[ok]))
        best <- max(best, s, na.rm = TRUE)
      }
      sim[i] <- best
    }
  }
  sim
}

run_cvtape_pipeline <- function(file_path = "Clone_of_Cabo_Verde_TAPE_Dataset_Blueprint.xlsx",
                                out_dir   = "outputs",
                                run_analysis = TRUE) {
  stopifnot(file.exists(file_path))
  if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
  
  # FIX 1: read by position (the first sheet's name is truncated by Excel)
  main    <- readxl::read_excel(file_path, sheet = 1,             guess_max = 100000)
  crops   <- readxl::read_excel(file_path, sheet = "crops",       guess_max = 100000)
  animals <- readxl::read_excel(file_path, sheet = "animals_001", guess_max = 100000)
  youth_m <- readxl::read_excel(file_path, sheet = "youthinfo_m", guess_max = 100000)
  youth_f <- readxl::read_excel(file_path, sheet = "youthinfo_f", guess_max = 100000)
  main    <- normalize_kobo_names(main)
  message("Loaded ", nrow(main), " farms, ", nrow(crops), " crop rows, ", nrow(animals), " animal rows.")
  
  # FIX 3: keep Kobo's own calculated values for auditing
  kobo_keep <- intersect(c("caet_score", "div_score", "synergy_score", "labour_socinq",
                           "human_score", "connect_ag", "fies_score", "dietary_score",
                           "econ_index", "landtenure_score_men_pct",
                           "landtenure_score_women_pct", "landtenure_score_household_pct",
                           "youth_score", "aweai", "gpi"), names(main))
  for (cl in kobo_keep) main[[paste0("kobo_", cl)]] <- main[[cl]]
  
  # QC flags (nothing is dropped; filter on these in the analysis)
  main$dup_questionnaire_id <- as.integer(duplicated(main$questionnaire_ID) |
                                            duplicated(main$questionnaire_ID, fromLast = TRUE))
  main$duration_min   <- as.numeric(difftime(main$end, main$start, units = "mins"))
  main$flag_fast      <- as.integer(!is.na(main$duration_min) & main$duration_min < 10)
  main$flag_open_24h  <- as.integer(!is.na(main$duration_min) & main$duration_min > 1440)
  # FIX 16: 331 interviews are > 4 h (forms left open / saved as draft), so the
  # clock time is meaningless for them. duration_valid_min is NA for those.
  main$duration_valid_min <- ifelse(!is.na(main$duration_min) & main$duration_min <= 240,
                                    main$duration_min, NA_real_)
  # Duplicate questionnaire IDs: separate true double submissions from ID reuse.
  main$dup_id_similarity <- flag_duplicate_ids(main)
  main$flag_likely_duplicate <- as.integer(!is.na(main$dup_id_similarity) & main$dup_id_similarity >= 0.8)
  
  # One consistent farm-size variable in hectares (areas are already in ha in
  # the *_ha columns; negative codes such as -99 are set to NA)
  area_cols <- intersect(c("land_owned_ha", "land_rentin_ha", "land_other_ha"), names(main))
  area_mat  <- sapply(area_cols, function(cn) { a <- as_num(main[[cn]]); a[!is.na(a) & a < 0] <- NA_real_; a })
  main$farm_area_ha <- ifelse(rowSums(!is.na(area_mat)) == 0, NA_real_, rowSums(area_mat, na.rm = TRUE))
  
  validate_tape_data(main)
  
  scored <- compute_caet(main)
  scored <- compute_tape_performance(scored, crop_data = crops, animal_data = animals,
                                     youth_m_data = youth_m, youth_f_data = youth_f)
  
  # Console summary of what the fixes did
  message("CAET: n = ", sum(!is.na(scored$caet_score)), ", mean = ",
          round(mean(scored$caet_score, na.rm = TRUE), 2),
          ", farms with a -99 Step 1 answer: ", sum(scored$caet_dk_flag, na.rm = TRUE))
  message("Likely true duplicate submissions (rows, similarity >= 0.8): ",
          sum(scored$flag_likely_duplicate, na.rm = TRUE),
          " -> review these and drop one of each pair before the analysis.")
  if ("enumerator" %in% names(scored)) {
    tb <- aggregate(flag_fast ~ enumerator, data = scored,
                    FUN = function(z) c(n = length(z), fast = sum(z)))
    tb <- data.frame(enumerator = tb$enumerator, n = tb$flag_fast[, "n"], fast = tb$flag_fast[, "fast"])
    tb$share_fast <- round(tb$fast / tb$n, 2)
    tb <- tb[tb$n >= 10, , drop = FALSE]
    tb <- tb[order(-tb$share_fast), , drop = FALSE]
    message("Enumerators (n >= 10) with the highest share of interviews < 10 min:")
    print(utils::head(tb, 10), row.names = FALSE)
  }
  message("Duplicate questionnaire IDs (rows): ", sum(scored$dup_questionnaire_id),
          " | interviews < 10 min: ", sum(scored$flag_fast, na.rm = TRUE),
          " | open > 24 h: ", sum(scored$flag_open_24h, na.rm = TRUE))
  
  id_cols <- intersect(c("_id", "_uuid", "questionnaire_ID", "region", "Islands",
                         "Municipality", "Locality", "enumerator", "datacollection_date",
                         "Sex_head", "farm_area_ha", "raises_animals"), names(scored))
  caet_cols <- intersect(c("div_score", "synergy_score", "recycling_score", "efficiency_score",
                           "resilience_score", "cultfood_score", "cocrea_score", "human_score",
                           "circular_score", "respgov_score", "caet_score", "caet_no_livestock",
                           "caet_dk_flag"), names(scored))
  step2_cols <- intersect(c("fies_score", "fies_cat", "dietary_score", "dietary_score_strict",
                            "minimum_diet", "econ_index", "landtenure_score_men_pct",
                            "landtenure_score_women_pct", "landtenure_score_household_pct",
                            "landtenure_score_household_pct", "youth_score", "youth_emp_score",
                            "youth_emig_score", "youth_emp_score_clean", "youth_emig_score_clean",
                            "youth_score_clean", "pest_exposure_score", "pest_exposure_cat",
                            "pest_flag_kobo_nonuser", "fies_complete", "fies_dk_n", "fies_sum_lb",
                            "aweai", "aweai_gpi_capped", "women_5de_pct", "women_5de_4of5",
                            "women_5de_n_domains", "aweai_coverage",
                            "final_exposure", "exposure", "share_sold", "GSIndex_crops",
                            "GSIndex_crops_complete", "GSIndex_animals", "GSI_overall",
                            "n_crops_dk_area"), names(scored))
  qc_cols <- intersect(c("dup_questionnaire_id", "dup_id_similarity", "flag_likely_duplicate",
                         "duration_min", "duration_valid_min", "flag_fast", "flag_open_24h"),
                       names(scored))
  analysis <- scored[, unique(c(id_cols, caet_cols, step2_cols, qc_cols)), drop = FALSE]
  
  write.csv(scored,   file.path(out_dir, "cvtape_scored_all.csv"),      row.names = FALSE)
  write.csv(analysis, file.path(out_dir, "cvtape_analysis_ready.csv"),  row.names = FALSE)
  print(tape_performance_summary(scored))

  # Batch 3: cleaning (labels, duplicates, farm size, A-WEAI 4-of-5, MDD-W, dates)
  cleaned <- clean_cvtape(scored, out_dir = file.path(out_dir, "clean"))
  # Batch 4: statistical analysis (set run_analysis = FALSE to skip)
  analysed <- if (run_analysis) analyze_cvtape(cleaned$clean, out_dir = file.path(out_dir, "analysis")) else NULL
  invisible(list(scored = scored, analysis = analysis, clean = cleaned$clean,
                 cleaning_log = cleaned$log, analysed = analysed))
}

if (!exists("CVTAPE_NO_AUTORUN")) {
  cvtape <- run_cvtape_pipeline(file_path)
}
