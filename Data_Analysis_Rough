                               ifelse(d$dietary_score_mddw >= 50, "Yes", "No"))
add_log("7 MDD-W", "respondents with a diet score", sum(!is.na(d$dietary_score_resp)))
add_log("7 MDD-W", "of which women 15-49 (MDD-W eligible)", sum(!is.na(d$dietary_score_mddw)))
add_log("7 MDD-W", "women with diet score but unknown age", sum(d$mddw_age_unknown))

# -----------------------------------------------------------------------------
# 8. Dates
# -----------------------------------------------------------------------------
d$collection_date <- as.Date(substr(as.character(d$datacollection_date), 1, 10))
d$entry_date      <- as.Date(substr(as.character(d$start), 1, 10))
d$entry_lag_days  <- as.integer(d$entry_date - d$collection_date)
add_log("8 dates", paste("collection dates", min(d$collection_date, na.rm = TRUE), "to", max(d$collection_date, na.rm = TRUE)), sum(!is.na(d$collection_date)))
add_log("8 dates", paste("entry dates", min(d$entry_date, na.rm = TRUE), "to", max(d$entry_date, na.rm = TRUE)), sum(!is.na(d$entry_date)))
add_log("8 dates", "entries with entry earlier than collection (check)", sum(d$entry_lag_days < 0, na.rm = TRUE))
# interview durations are meaningless for paper-then-entry data: do not analyse them
for (cn in intersect(c("duration_min", "duration_valid_min", "flag_fast", "flag_open_24h"), names(d))) d[[cn]] <- NULL

# -----------------------------------------------------------------------------
# 9. Outlier screen (FLAGS ONLY: no value is changed or removed)
# -----------------------------------------------------------------------------
# Two kinds of check on the rows that are kept (duplicates already excluded):
#  a) impossible values (hard rules)  -> flag_invalid_value, with the reason in the review file
#  b) statistical outliers (Tukey fences): 1 = beyond 1.5 x IQR (mild), 2 = beyond 3 x IQR
#     (extreme). Skewed variables (areas, household size) are screened on log1p(x).
# Bounded 0-100 scores are only range-checked: fences on them would flag valid 0/100 answers.
# A flagged value may be real (a large farm, a big household). Check the paper form first.
keep <- d$dup_dropped == 0
out_rows <- list()
add_out <- function(idx, var, reason, value) {
  idx <- which(idx)
  if (!length(idx)) return(invisible(NULL))
  out_rows[[length(out_rows) + 1]] <<- data.frame(
    questionnaire_ID = d$questionnaire_ID[idx], island = d$island_name[idx],
    municipality = d$Municipality[idx], variable = var, reason = reason,
    value = value[idx], stringsAsFactors = FALSE)
}

# a) impossible values
inv <- rep(FALSE, nrow(d))
area_cols <- intersect(c("area_tem_crop_ha", "area_per_crop_ha", "area_tem_meapas_ha",
                         "area_per_meapas_ha", "area_tem_fal_ha", "area_per_meapas_ha",
                         "area_yard_ha", "area_forest_ha", "area_aquac_ha", "area_other_ha",
                         "area_common_ha", "land_owned_ha", "land_rentin_ha", "land_other_ha"), names(d))
for (cn in unique(area_cols)) {
  v <- num(d[[cn]]); k <- keep & !is.na(v) & v < 0
  add_out(k, cn, "negative area", v); inv <- inv | k
  add_log("9 outliers", paste("negative area in", cn), sum(k))
}
rng <- list(age_respond = c(18, 110), Age_head = c(18, 110), hh_size = c(1, 30),
            caet_score = c(0, 100), econ_index = c(0, 100), fies_score = c(0, 100),
            GSI_overall = c(0, 100), aweai_4of5 = c(0, 100))
for (cn in intersect(names(rng), names(d))) {
  v <- num(d[[cn]]); k <- keep & !is.na(v) & (v < rng[[cn]][1] | v > rng[[cn]][2])
  add_out(k, cn, paste0("outside ", rng[[cn]][1], "-", rng[[cn]][2]), v); inv <- inv | k
  add_log("9 outliers", paste(cn, "outside", rng[[cn]][1], "-", rng[[cn]][2]), sum(k))
}
d$flag_invalid_value <- as.integer(inv)

# b) statistical outliers
fence_flag <- function(x, log = FALSE) {
  v <- if (log) log1p(pmax(x, 0)) else x
  ok <- keep & !is.na(v)
  q <- quantile(v[ok], c(0.25, 0.75), names = FALSE); iqr <- q[2] - q[1]
  f <- rep(0L, length(v))
  f[!is.na(v) & (v < q[1] - 1.5 * iqr | v > q[2] + 1.5 * iqr)] <- 1L
  f[!is.na(v) & (v < q[1] - 3   * iqr | v > q[2] + 3   * iqr)] <- 2L
  f[!keep] <- 0L
  hi <- q[2] + 3 * iqr; if (log) hi <- expm1(hi)
  list(flag = f, upper_extreme = hi)
}
stat_vars <- list(farm_area_ha = TRUE, farm_area_tenure_ha = TRUE, hh_size = TRUE,
                  age_respond = FALSE, Age_head = FALSE)
ext_any <- rep(FALSE, nrow(d))
for (cn in intersect(names(stat_vars), names(d))) {
  v <- num(d[[cn]]); r <- fence_flag(v, stat_vars[[cn]])
  d[[paste0("flag_out_", cn)]] <- r$flag
  add_out(r$flag == 2L, cn, "extreme outlier (beyond 3 x IQR)", v)
  ext_any <- ext_any | r$flag == 2L
  add_log("9 outliers", paste0(cn, " mild (1.5 x IQR)"), sum(r$flag == 1L))
  add_log("9 outliers", paste0(cn, " extreme (3 x IQR; limit ~", signif(r$upper_extreme, 3), ")"), sum(r$flag == 2L))
}
d$flag_outlier_any <- as.integer(ext_any | inv)
add_log("9 outliers", "households with an invalid value or an extreme outlier (review)", sum(d$flag_outlier_any[keep]))
outliers <- if (length(out_rows)) do.call(rbind, out_rows) else
  data.frame(questionnaire_ID = character(), island = character(), municipality = character(),
             variable = character(), reason = character(), value = numeric())
outliers <- outliers[order(outliers$variable, -abs(outliers$value)), ]
write.csv(outliers, file.path(out_dir, "cvtape_review_outliers.csv"), row.names = FALSE, fileEncoding = "UTF-8")

# -----------------------------------------------------------------------------
# Write
# -----------------------------------------------------------------------------
d$start_ts <- NULL
clean <- d[d$dup_dropped == 0, , drop = FALSE]
write.csv(clean, file.path(out_dir, "cvtape_clean.csv"), row.names = FALSE, fileEncoding = "UTF-8")
add_log("output", "rows in input", n_start)
add_log("output", "rows in cvtape_clean.csv", nrow(clean))
write.csv(clog, file.path(out_dir, "cvtape_cleaning_log.csv"), row.names = FALSE, fileEncoding = "UTF-8")
options(width = 200); print(clog, right = FALSE, row.names = FALSE)

  invisible(list(clean = clean, log = clog, review_duplicates = review, review_outliers = outliers))
}

################################################################################
# STATISTICAL ANALYSIS (batch 4): analyze_cvtape(), runs after the cleaning step
# Writes tables (csv) and figures (png) to outputs/analysis/. Nothing here changes
# the cleaned data. Every section is wrapped so that one failure does not stop the rest.
#   A1 Descriptives and missingness      A6 Principal component analysis (PCA)
#   A2 Distribution plots                A7 Clustering (farm typology, Step 1bis)
#   A3 Kruskal-Wallis + Dunn (islands)   A8 Multiple regression (robust SE)
#   A4 Spearman correlations             A9 Multilevel models (municipality)
#   A5 Multicollinearity checks          A10 Sensitivity runs
# Design choices:
#   * CAET (caet_score) is used ALONE as the agroecology predictor. The ten element
#     scores are never put in the same model as CAET (it is their mean, so that would
#     be perfectly collinear). Elements are used in correlations, PCA and clustering.
#   * Soil health is not scored (the Cabo Verde form has no soil module). "Added value"
#     is represented by share_sold (0-3, -99 = missing), treated as an ordinal proxy.
#   * Bounded 0-100 scores: OLS with HC3 robust SE as the main model, plus a fractional
#     logit (quasibinomial) as a check. Ordinal outcomes use proportional-odds models.
################################################################################
analyze_cvtape <- function(clean, out_dir = "outputs/analysis", seed = 2026,
                           k_range = 3:6, k_override = NULL, boot_B = 100, gap_B = 50) {
  if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)
  set.seed(seed)
  have <- function(p) requireNamespace(p, quietly = TRUE)
  num  <- function(x) suppressWarnings(as.numeric(as.character(x)))
  say  <- function(...) message("[analysis] ", ...)
  wcsv <- function(x, f) write.csv(x, file.path(out_dir, f), row.names = FALSE, fileEncoding = "UTF-8")
  sect <- function(name, expr) {
    say(name)
    tryCatch(expr, error = function(e) { say("  FAILED: ", conditionMessage(e)); NULL })
  }
  holm <- function(p) p.adjust(p, "holm")
  fmtp <- function(p) ifelse(is.na(p), NA, ifelse(p < 0.001, "<0.001", sprintf("%.3f", p)))

  # ---------------------------------------------------------------------------
  # Variables
  # ---------------------------------------------------------------------------
  elements <- c(div_score = "Diversity", synergy_score = "Synergies", recycling_score = "Recycling",
                efficiency_score = "Efficiency", resilience_score = "Resilience",
                cultfood_score = "Culture & food traditions", cocrea_score = "Co-creation of knowledge",
                human_score = "Human & social values", circular_score = "Circular & solidarity economy",
                respgov_score = "Responsible governance")
  criteria <- c(landtenure_score_household_pct = "Land tenure security",
                econ_index = "Economic index (productivity/income)",
                dietary_score = "Women's dietary diversity (MDD-W score)",
                aweai_4of5 = "Women's empowerment (A-WEAI, 4 of 5)",
                youth_score_clean = "Youth (employment & emigration)",
                GSI_overall = "Biodiversity (Gini-Simpson)",
                fies_score = "Food security (FIES score)",
                pest_exposure_score = "Pesticide exposure (100 = no/low risk)")
  elements <- elements[names(elements) %in% names(clean)]
  criteria <- criteria[names(criteria) %in% names(clean)]
  stopifnot(length(elements) >= 8, "caet_score" %in% names(clean))

  d <- as.data.frame(clean, stringsAsFactors = FALSE)
  for (v in c(names(elements), names(criteria), "caet_score", "caet_no_livestock", "aweai_gpi_capped",
              "farm_area_ha", "hh_size", "Age_head", "Sex_head", "raises_animals", "share_sold"))
    if (v %in% names(d)) d[[v]] <- num(d[[v]])
  d$island      <- factor(d$island_name, levels = c("Santiago", "Fogo", "Santo Antao"))
  d$municipality <- factor(d$Municipality)
  d$log_area    <- log1p(d$farm_area_ha)
  d$age_head    <- d$Age_head
  d$head_sex    <- factor(d$Sex_head)            # codes as in the form (1, 2); 1 is the reference
  d$livestock   <- as.integer(d$raises_animals)
  d$caet10      <- d$caet_score / 10               # effect per 10 CAET points
  d$share_sold[!is.na(d$share_sold) & d$share_sold < 0] <- NA
  d$fies_cat_o  <- factor(d$fies_cat, levels = c("Food secure", "Mildly food insecure",
                          "Moderately food insecure", "Severely food insecure"), ordered = TRUE)
  d$share_sold_o <- factor(d$share_sold, levels = 0:3, ordered = TRUE)
  d$minimum_diet_b <- ifelse(d$minimum_diet %in% c("Yes", "No"), as.integer(d$minimum_diet == "Yes"), NA)
  d$outlier <- if ("flag_outlier_any" %in% names(d)) d$flag_outlier_any == 1 else FALSE
