  pca_run <- function(vars, tag, label) {
    cc <- complete.cases(d[, vars]); X <- d[cc, vars]; X <- X[, apply(X, 2, sd) > 0, drop = FALSE]
    p <- prcomp(X, center = TRUE, scale. = TRUE)
    ev <- p$sdev^2
    tab <- data.frame(component = paste0("PC", seq_along(ev)), eigenvalue = round(ev, 3),
                      pct_variance = round(100 * ev / sum(ev), 1), cumulative_pct = round(100 * cumsum(ev) / sum(ev), 1))
    wcsv(tab, paste0("A6_pca_", tag, "_variance.csv"))
    ld <- p$rotation[, 1:min(4, ncol(p$rotation)), drop = FALSE]
    wcsv(data.frame(variable = rownames(ld), label = unname(label[rownames(ld)]), round(ld, 3)), paste0("A6_pca_", tag, "_loadings.csv"))
    png(file.path(out_dir, paste0("A6_pca_", tag, ".png")), width = 1700, height = 800, res = 130)
    par(mfrow = c(1, 2), mar = c(4, 4, 3, 1))
    plot(ev, type = "b", pch = 19, xlab = "Component", ylab = "Eigenvalue", main = paste("Scree plot:", tag)); abline(h = 1, lty = 2, col = 2)
    sc <- p$x[, 1:2]; plot(sc, pch = 20, cex = .5, col = "grey60", xlab = sprintf("PC1 (%.0f%%)", tab$pct_variance[1]), ylab = sprintf("PC2 (%.0f%%)", tab$pct_variance[2]), main = "Biplot")
    a <- p$rotation[, 1:2] * max(abs(sc)) * 0.9; arrows(0, 0, a[, 1], a[, 2], length = .08, col = 2)
    text(a[, 1] * 1.08, a[, 2] * 1.08, abbreviate(rownames(a), 8), cex = .6, col = 2)
    dev.off()
    say("  PCA ", tag, ": n = ", sum(cc), "; components with eigenvalue > 1: ", sum(ev > 1),
        "; PC1-2 explain ", tab$cumulative_pct[2], "%")
    list(p = p, rows = which(cc))
  }
