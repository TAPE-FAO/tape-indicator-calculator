  cont <- c(names(criteria))
  rhs <- function(pred) paste(c(pred, covars), collapse = " + ")
  fit_cont <- function(y, data, pred = "caet10") {
    f <- as.formula(paste(y, "~", rhs(pred)))
    ok <- complete.cases(data[, c(y, pred, covars)])
    m <- lm(f, data = data[ok, ])
    rb <- lmtest::coeftest(m, vcov = sandwich::vcovHC(m, type = "HC3"))
    ci <- lmtest::coefci(m, vcov. = sandwich::vcovHC(m, type = "HC3"))
    cd <- cooks.distance(m)
    list(m = m, rb = rb, ci = ci, n = sum(ok), r2 = summary(m)$r.squared, adj = summary(m)$adj.r.squared,
         bp = tryCatch(lmtest::bptest(m)$p.value, error = function(e) NA),
         cook_n = sum(cd > 4 / length(cd)), cook_max = max(cd), pred = pred, y = y)
  }
  coef_rows <- function(fit, model) {
    rb <- fit$rb; data.frame(outcome = fit$y, model = model, n = fit$n, term = rownames(rb), estimate = rb[, 1],
                             robust_se = rb[, 2], p = rb[, 4], ci_low = fit$ci[, 1], ci_high = fit$ci[, 2], row.names = NULL)
  }
