add_log("6 A-WEAI", "households with aweai_4of5", sum(!is.na(d$aweai_4of5)))
same <- !is.na(num(d$aweai_gpi_capped)) & !is.na(d$aweai_4of5)
add_log("6 A-WEAI", "check: 4of5 equals capped original where both exist (rows differing > 0.05)",
        sum(abs(num(d$aweai_gpi_capped)[same] - d$aweai_4of5[same]) > 0.05))

# -----------------------------------------------------------------------------
# 7. Dietary diversity: MDD-W eligibility
# -----------------------------------------------------------------------------
need(c("dietary_score", "sex_respondent", "age_respond"))
sx <- num(d$sex_respondent); ag <- num(d$age_respond)
d$dietary_score_resp <- num(d$dietary_score)      # all respondents, 10-group score
