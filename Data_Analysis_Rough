      g <- tryCatch(MASS::polr(as.formula(paste(y, "~", rhs("caet10"))), data = d[ok, ], Hess = TRUE), error = function(e) NULL)
      if (is.null(g)) next
      s <- summary(g)$coefficients; z <- s["caet10", "Value"] / s["caet10", "Std. Error"]
      rows[[y]] <- data.frame(outcome = y, model = "Ordinal logit (log-odds per 10 CAET points)", n = sum(ok), term = "caet10", estimate = s["caet10", "Value"],
        robust_se = s["caet10", "Std. Error"], p = 2 * pnorm(-abs(z)), ci_low = s["caet10", "Value"] - 1.96 * s["caet10", "Std. Error"],
        ci_high = s["caet10", "Value"] + 1.96 * s["caet10", "Std. Error"], row.names = NULL)
    }
    # logistic: minimum dietary diversity
    ok <- complete.cases(d[, c("minimum_diet_b", "caet10", covars)])
    g <- tryCatch(glm(as.formula(paste("minimum_diet_b ~", rhs("caet10"))), data = d[ok, ], family = binomial()), error = function(e) NULL)
    if (!is.null(g)) {
      rb <- lmtest::coeftest(g, vcov = sandwich::vcovHC(g, type = "HC3")); ci <- lmtest::coefci(g, vcov. = sandwich::vcovHC(g, type = "HC3"))
      rows[["mdd"]] <- data.frame(outcome = "minimum_diet_b", model = "Logistic (log-odds per 10 CAET points)", n = sum(ok), term = "caet10", estimate = rb["caet10", 1],
        robust_se = rb["caet10", 2], p = rb["caet10", 4], ci_low = ci["caet10", 1], ci_high = ci["caet10", 2], row.names = NULL)
    }
    caet_tab <- do.call(rbind, rows)
    caet_tab$p_holm_within_model <- NA
    for (m in unique(caet_tab$model)) { i <- caet_tab$model == m; caet_tab$p_holm_within_model[i] <- holm(caet_tab$p[i]) }
    caet_tab[, c("estimate", "robust_se", "ci_low", "ci_high")] <- lapply(caet_tab[, c("estimate", "robust_se", "ci_low", "ci_high")], round, 3)
    caet_tab$p <- signif(caet_tab$p, 3); caet_tab$p_holm_within_model <- signif(caet_tab$p_holm_within_model, 3)
    wcsv(caet_tab, "A8_caet_effects.csv")
  })

  # ---------------------------------------------------------------------------
  # A9. Multilevel models: households within municipalities (random intercept)
  # ---------------------------------------------------------------------------
  ml_tab <- NULL
  sect("A9 multilevel models", {
    if (!have("lme4") || !have("lmerTest")) stop("lme4/lmerTest not installed")
    fx <- paste(c("caet10", covars), collapse = " + ")
    res <- lapply(cont, function(y) {
      dd <- d[complete.cases(d[, c(y, "caet10", covars, "municipality")]), ]
      dd$municipality <- droplevels(dd$municipality)
      if (nlevels(dd$municipality) < 5) return(NULL)
      m0 <- lme4::lmer(as.formula(paste(y, "~ 1 + (1 | municipality)")), data = dd, REML = TRUE)
      vc <- as.data.frame(lme4::VarCorr(m0)); icc <- vc$vcov[1] / sum(vc$vcov)
      m1 <- lmerTest::lmer(as.formula(paste(y, "~", fx, "+ (1 | municipality)")), data = dd, REML = TRUE)
      s <- summary(m1)$coefficients["caet10", ]
      ci <- suppressWarnings(tryCatch(confint(m1, parm = "caet10", method = "Wald"), error = function(e) c(NA, NA)))
      ols <- if (!is.null(main_fits[[y]])) main_fits[[y]]$rb["caet10", 1] else NA
      data.frame(outcome = y, n = nrow(dd), n_municipalities = nlevels(dd$municipality), icc_municipality = round(icc, 3),
                 caet10_estimate = round(s["Estimate"], 3), se = round(s["Std. Error"], 3), df = round(s["df"], 1),
                 p = signif(s["Pr(>|t|)"], 3), ci_low = round(ci[1], 3), ci_high = round(ci[2], 3),
                 ols_estimate_for_comparison = round(ols, 3), singular_fit = lme4::isSingular(m1), row.names = NULL)
    })
    ml_tab <- do.call(rbind, Filter(Negate(is.null), res))
    ml_tab$p_holm <- signif(holm(ml_tab$p), 3)
    wcsv(ml_tab, "A9_multilevel_caet_effects.csv")
    say("  ICC (share of variance between municipalities) ranges ", min(ml_tab$icc_municipality), " to ", max(ml_tab$icc_municipality))
  })

  # ---------------------------------------------------------------------------
  # A10. Sensitivity runs
  # ---------------------------------------------------------------------------
  sect("A10 sensitivity runs", {
    versions <- list()
    versions[["main"]] <- d
    versions[["without flagged outliers"]] <- d[!d$outlier, ]
    dn <- d; dn$caet10 <- dn$caet_no_livestock / 10; versions[["CAET without livestock items"]] <- dn
    # the duplicate pairs whose CAET differs: use the dropped entry's CAET instead
    rf <- file.path(out_dir, "..", "clean", "cvtape_review_duplicates.csv")
    if (file.exists(rf)) {
      rv <- read.csv(rf, stringsAsFactors = FALSE); rv$caet_dropped <- num(rv$caet_dropped)
      rv <- rv[!is.na(rv$caet_dropped) & !is.na(rv$caet_kept) & abs(rv$caet_dropped - rv$caet_kept) > 0.005, ]
      dd <- d; i <- match(rv$questionnaire_ID, dd$questionnaire_ID)
      dd$caet10[i[!is.na(i)]] <- rv$caet_dropped[!is.na(i)] / 10
      versions[["duplicate pairs: other entry's CAET"]] <- dd
    }
    out <- list()
    for (nm in names(versions)) for (y in cont) {
      f <- tryCatch(fit_cont(y, versions[[nm]]), error = function(e) NULL)
      if (!is.null(f)) { r <- caet_row(f, nm); out[[length(out) + 1]] <- r }
    }
    # A-WEAI with all five domains (original score)
    if ("aweai_gpi_capped" %in% names(d)) {
      f <- tryCatch(fit_cont("aweai_gpi_capped", d), error = function(e) NULL)
      if (!is.null(f)) out[[length(out) + 1]] <- caet_row(f, "A-WEAI with all 5 domains (n smaller)")
    }
    st <- do.call(rbind, out)
    st[, c("estimate", "robust_se", "ci_low", "ci_high")] <- lapply(st[, c("estimate", "robust_se", "ci_low", "ci_high")], round, 3)
    st$p <- signif(st$p, 3)
    wcsv(st, "A10_sensitivity_caet_effects.csv")
    # does the sign / significance of the CAET effect hold across versions?
    wide <- reshape(st[, c("outcome", "model", "estimate")], idvar = "outcome", timevar = "model", direction = "wide")
    wcsv(wide, "A10_sensitivity_estimates_wide.csv")
    # island differences in CAET under the alternative scores
    dn$caet_score <- dn$caet_no_livestock
    kw_nl <- kruskal.test(caet_no_livestock ~ island, data = d)
    kw_ot <- kruskal.test(caet_score ~ island, data = d[!d$outlier, ])
    wcsv(data.frame(version = c("CAET without livestock items", "CAET without flagged outliers"),
                    H = round(c(kw_nl$statistic, kw_ot$statistic), 2), p = signif(c(kw_nl$p.value, kw_ot$p.value), 3)),
         "A10_sensitivity_kruskal_islands.csv")
  })

  say("done. Tables and figures are in ", out_dir)
  invisible(list(data = d, caet_effects = caet_tab, multilevel = ml_tab))
}

