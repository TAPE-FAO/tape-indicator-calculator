    sil <- sapply(seq_along(ks), function(i) mean(cluster::silhouette(km[[i]]$cluster, D)[, 3]))
    sil_h <- sapply(ks, function(k) mean(cluster::silhouette(cutree(hc, k), D)[, 3]))
    gp <- cluster::clusGap(Z, FUN = function(x, k) list(cluster = kmeans(x, k, nstart = 20, iter.max = 100)$cluster),
                           K.max = max(k_range), B = gap_B)
    gt <- gp$Tab
    sel <- data.frame(k = ks, silhouette_kmeans = round(sil, 3), silhouette_ward = round(sil_h, 3),
                      gap = round(gt[ks, "gap"], 3), gap_se = round(gt[ks, "SE.sim"], 3),
                      tot_withinss = round(sapply(km, `[[`, "tot.withinss"), 1))
    wcsv(sel, "A7_cluster_selection.csv")
    inr <- sel$k %in% k_range
    k <- if (!is.null(k_override)) k_override else sel$k[inr][which.max(sel$silhouette_kmeans[inr])]
    say("  chosen k = ", k, " (best k-means silhouette within ", min(k_range), "-", max(k_range), ")")
    png(file.path(out_dir, "A7_cluster_selection.png"), width = 1800, height = 700, res = 130)
    par(mfrow = c(1, 3), mar = c(4, 4, 3, 1))
    plot(ks, sil, type = "b", pch = 19, xlab = "k", ylab = "Mean silhouette", main = "Silhouette (k-means)"); abline(v = k, lty = 3)
    plot(ks, gt[ks, "gap"], type = "b", pch = 19, xlab = "k", ylab = "Gap", main = "Gap statistic")
    plot(hc, labels = FALSE, hang = -1, main = "Ward dendrogram", xlab = "", sub = ""); rect.hclust(hc, k = k, border = 2:7)
    dev.off()
    fit <- km[[match(k, ks)]]
    # stability by bootstrap (Jaccard); label order by CAET
    # stability: bootstrap Jaccard of each cluster (Hennig): refit on a resample, assign the
    # sampled points to the nearest new centre, compare with the original cluster
    n_z <- nrow(Z); jac <- matrix(NA_real_, boot_B, k)
    for (b in seq_len(boot_B)) {
      idx <- sample(n_z, replace = TRUE); u <- unique(idx)
      kb <- kmeans(Z[idx, ], centers = k, nstart = 10, iter.max = 100)
      d2 <- sapply(seq_len(k), function(j) rowSums((Z[u, , drop = FALSE] - matrix(kb$centers[j, ], length(u), ncol(Z), byrow = TRUE))^2))
      asg <- max.col(-d2)
      for (cl in seq_len(k)) {
        a <- fit$cluster[u] == cl
        jac[b, cl] <- max(sapply(seq_len(k), function(j) { s <- asg == j; sum(a & s) / sum(a | s) }))
      }
    }
    stab <- round(colMeans(jac), 3)
    ord <- order(tapply(d$caet_score[cc], fit$cluster, mean))
    lab <- paste0("Type ", seq_len(k))
    d$farm_type[cc] <- NA
    ft <- lab[match(fit$cluster, ord)]
    d$farm_type[cc] <- ft
    say("  type sizes (ordered by mean CAET, lowest first): ", paste(table(ft)[lab], collapse = " / "))
    prof <- do.call(rbind, lapply(lab, function(l) {
      i <- which(d$farm_type == l)
      data.frame(type = l, n = length(i), pct = round(100 * length(i) / length(cc), 1),
                 bootstrap_jaccard = if (length(stab) == k) stab[ord[match(l, lab)]] else NA,
                 caet_mean = round(mean(d$caet_score[i], na.rm = TRUE), 1),
                 t(round(sapply(names(elements), function(v) mean(d[[v]][i], na.rm = TRUE)), 1)),
                 pct_santiago = round(100 * mean(d$island[i] == "Santiago"), 1),
                 pct_fogo = round(100 * mean(d$island[i] == "Fogo"), 1),
                 pct_santo_antao = round(100 * mean(d$island[i] == "Santo Antao"), 1),
                 median_farm_ha = round(median(d$farm_area_ha[i], na.rm = TRUE), 2),
                 pct_livestock = round(100 * mean(d$livestock[i] == 1, na.rm = TRUE), 1))
    }))
    wcsv(prof, "A7_cluster_profiles.csv")
    d$farm_type <- factor(d$farm_type, levels = lab)
    wcsv(data.frame(questionnaire_ID = d$questionnaire_ID, island = d$island_name, farm_type = d$farm_type), "A7_farm_type_assignments.csv")
    # do the types differ in performance? (descriptive: types were built from the elements, not from criteria)
    kw_table(d$farm_type, names(criteria), "farm_type_criteria")
    # PCA plot coloured by type
    if (!is.null(pca_el)) {
      png(file.path(out_dir, "A7_types_on_pca.png"), width = 1000, height = 850, res = 130)
      sc <- pca_el$p$x[, 1:2]; idx <- pca_el$rows
