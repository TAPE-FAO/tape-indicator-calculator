#' Safe numeric coercion (returns NA for blank / non-numeric)
as_num <- function(x) suppressWarnings(as.numeric(as.character(x)))

#' Round to 2 decimal places (matches XLSForm round(..., 2))
r2 <- function(x) round(x, 2)

#' Coerce a 0/0.5/1/1.5/2 ordinal score column to numeric
score_col <- function(df, col) {
  if (col %in% names(df)) as_num(df[[col]]) else NA_real_
}

#' Check if a field is non-missing (mirrors XLSForm != "")
has_val <- function(x) !is.na(x)

#' Strip KoboToolbox folder-style prefixes from exported column names.
#' Names that would collide after stripping (the 0,1,2,...,77,dk_refuse,-99
#' children of select-multiple questions) keep their parent question:
#' "farm_confirmation/farm_char/farm_mgt/0" -> "farm_mgt__0".
#' The function is idempotent (safe to call more than once).
normalize_kobo_names <- function(df) {
  df    <- as.data.frame(df, check.names = FALSE)
  full  <- names(df)
  short <- sub(".*/", "", full)
  dup   <- short %in% short[duplicated(short)]
  parts <- strsplit(full, "/", fixed = TRUE)
  parent <- vapply(parts, function(p) if (length(p) >= 2) p[length(p) - 1] else "",
                   character(1))
  new <- ifelse(dup & parent != "", paste0(parent, "__", short), short)
  names(df) <- make.unique(new)
  df
}

#' All ordinal Step 1 input columns (0 / 0.5 / 1 / 1.5 / 2; -99 = don't know)
CAET_ORDINAL_COLS <- c(
  "num_plant", "plant_gendiv", "temp_div", "space_div", "num_animal", "anim_gendiv",
  "feed_prod", "vary_service", "tree_farm", "tree_divspe", "plot_mosaic", "natveg_pct",
  "useloc_seedbreed", "nat_seedbreed", "reuse_orgres", "nonorg_waste",
  "source_water", "source_energy", "onfarm_nutcycle", "nitrogen_plant", "onf_eco",
  "use_vet", "water_use_save", "energy_use_save", "community_coop", "ext_finance",
  "div_activ", "farminput_auto", "soil_cover", "soil_disturb", "food_div",
  "farm_ingred", "trad_food", "value_heritage", "context_know", "share_aginnov",
  "know_platform", "know_process", "women_role", "youth", "workcond_farmer",
  "workcond_emp", "agro_innov", "activ_outside", "local_market_share", "pgs_cert",
  "orig_inputs", "resource_share", "auto_dec", "access_finance", "access_land",
  "access_gene"
)

