add_log("1 check", "municipality not in the known list (review)", sum(d$flag_geo_unknown_municipality))

# ID prefix as a check only
id <- toupper(trimws(as.character(d$questionnaire_ID)))
prefix_island <- ifelse(startsWith(id, "TPFG"), 3, ifelse(startsWith(id, "TPSA"), 8, 7))
