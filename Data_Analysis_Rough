# -----------------------------------------------------------------------------
# 5. Farm size
# -----------------------------------------------------------------------------
need(c("area_total_ha", "farm_area_ha", "area_umeas"))
tot <- num(d$area_total_ha); tot[!is.na(tot) & tot < 0] <- NA_real_
d$farm_area_tenure_ha <- num(d$farm_area_ha)       # owned + rented-in + other
d$farm_area_ha        <- tot                       # land-use total = main variable
d$flag_area_mismatch  <- as.integer(!is.na(tot) & !is.na(d$farm_area_tenure_ha) &
                                      abs(tot - d$farm_area_tenure_ha) > 0.005)
d$flag_area_unit_unknown <- as.integer(trimws(as.character(d$area_umeas)) == "-99")
add_log("5 farm size", "farms with farm_area_ha available", sum(!is.na(d$farm_area_ha)))
add_log("5 farm size", "land-use vs tenure totals disagree (flag_area_mismatch)", sum(d$flag_area_mismatch, na.rm = TRUE))
add_log("5 farm size", "area unit unknown (paper form needed)", sum(d$flag_area_unit_unknown, na.rm = TRUE))

# -----------------------------------------------------------------------------
# 6. A-WEAI with 4 of 5 domains
# -----------------------------------------------------------------------------
w_cols <- c("wtime_alloc_women_score", "asset_ownership_women_score", "prod_asset_women_score",
            "dec_rev_women_score", "leadership_women")
m_cols <- c("wtime_alloc_men_score", "asset_ownership_men_score_001", "prod_asset_men_score_001",
            "dec_rev_men_score_001", "leadership_men")
need(c(w_cols, m_cols))
W <- sapply(w_cols, function(cn) num(d[[cn]])); M <- sapply(m_cols, function(cn) num(d[[cn]]))
nw <- rowSums(!is.na(W)); nm <- rowSums(!is.na(M))
w4 <- ifelse(nw >= 4, rowMeans(W, na.rm = TRUE), NA_real_)
m4 <- ifelse(nm >= 4, rowMeans(M, na.rm = TRUE), NA_real_)
d$aweai_n_domains_women <- nw
d$aweai_n_domains_men   <- nm
d$gpi_4of5   <- round(w4 / m4 * 100, 2)
d$aweai_4of5 <- round(0.9 * w4 * 100 + 0.1 * pmin(d$gpi_4of5, 100), 2)
