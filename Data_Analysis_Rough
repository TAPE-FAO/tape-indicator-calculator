  }
  num  <- function(x) suppressWarnings(as.numeric(as.character(x)))
  need <- function(cols) {
    miss <- setdiff(cols, names(d))
    if (length(miss)) stop("clean_cvtape: missing columns: ", paste(miss, collapse = ", "))
  }
  need(c("questionnaire_ID", "Islands", "Municipality", "supervisor",
         "start", "datacollection_date", "flag_likely_duplicate"))

# -----------------------------------------------------------------------------
# 1. Island and municipality
# -----------------------------------------------------------------------------
# The municipality is the most reliable field (each name belongs to one island),
# so it decides the island. The questionnaire-ID prefix is only used as a check:
# it contains typos (TPGF, TPFD, TPAS, TPSSA ...), so it is NOT used to recode.
d$Islands_raw      <- d$Islands
d$Municipality_raw <- d$Municipality
mun <- trimws(as.character(d$Municipality))
mun[mun == "Porto Nobo"] <- "Porto Novo"
