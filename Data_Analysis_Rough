  drop <- setdiff(rows, keep)
  d$dup_dropped[drop] <- 1L
  review <- rbind(review, data.frame(
    questionnaire_ID = g, row_kept = d[["_index"]][keep], row_dropped = paste(d[["_index"]][drop], collapse = ","),
    similarity = round(max(num(d$dup_id_similarity[rows]), na.rm = TRUE), 2),
    caet_kept = d$caet_score[keep], caet_dropped = paste(d$caet_score[drop], collapse = ","),
    verify_paper_form = as.integer(any(!is.na(d$caet_score[rows])) &&
                                     length(unique(round(d$caet_score[rows], 2))) > 1),
    stringsAsFactors = FALSE))
}
write.csv(review, file.path(out_dir, "cvtape_review_duplicates.csv"), row.names = FALSE,
          fileEncoding = "UTF-8")
add_log("3 duplicates", "rows dropped (earlier entry of each pair)", sum(d$dup_dropped))
add_log("3 duplicates", "pairs whose CAET differs -> check paper form", sum(review$verify_paper_form))

# -----------------------------------------------------------------------------
# 4. -99 in demographics
# -----------------------------------------------------------------------------
for (cn in intersect(c("age_respond", "Age_head", "sex_respondent", "Sex_head"), names(d))) {
  v <- num(d[[cn]]); k <- !is.na(v) & v == -99
  d[[cn]] <- ifelse(k, NA_real_, v)
