  # A3. Kruskal-Wallis (islands), Dunn post-hoc (Holm), chi-square for categories
  # ---------------------------------------------------------------------------
  dunn <- function(x, g) {
    ok <- !is.na(x) & !is.na(g); x <- x[ok]; g <- droplevels(g[ok]); N <- length(x)
    r <- rank(x); tt <- table(x); tie <- sum(tt^3 - tt) / (12 * (N - 1))
    lv <- levels(g); rb <- tapply(r, g, mean); ni <- table(g)
    out <- NULL
    for (i in 1:(length(lv) - 1)) for (j in (i + 1):length(lv)) {
      se <- sqrt((N * (N + 1) / 12 - tie) * (1 / ni[i] + 1 / ni[j]))
      z <- (rb[i] - rb[j]) / se
      out <- rbind(out, data.frame(group1 = lv[i], group2 = lv[j], z = unname(z), p = 2 * pnorm(-abs(z))))
    }
    out$p_holm <- p.adjust(out$p, "holm"); out
  }
  kw_table <- function(grp, vars, tag) {
    res <- lapply(vars, function(v) {
      ok <- !is.na(d[[v]]) & !is.na(grp)
      if (length(unique(grp[ok])) < 2) return(NULL)
      k <- kruskal.test(d[[v]][ok], grp[ok]); H <- unname(k$statistic); n <- sum(ok); kk <- nlevels(droplevels(grp[ok]))
      list(kw = data.frame(variable = v, label = unname(all_scores[v]), n = n, H = round(H, 2), df = kk - 1,
                           p = k$p.value, epsilon_sq = round((H - kk + 1) / (n - kk), 3)),
           dn = cbind(variable = v, dunn(d[[v]], grp)))
    })
    res <- Filter(Negate(is.null), res)
    kw <- do.call(rbind, lapply(res, `[[`, "kw")); kw$p_holm <- holm(kw$p)
    kw$p <- signif(kw$p, 3); kw$p_holm <- signif(kw$p_holm, 3)
    wcsv(kw, paste0("A3_kruskal_", tag, ".csv"))
    dn <- do.call(rbind, lapply(res, `[[`, "dn")); dn[, c("z", "p", "p_holm")] <- lapply(dn[, c("z", "p", "p_holm")], signif, 3)
    wcsv(dn, paste0("A3_dunn_", tag, ".csv"))
    kw
  }
