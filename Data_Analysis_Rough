# 'Santa Catarina' exists on Santiago; the same name recorded with the Fogo island
# code (3) is Santa Catarina do Fogo.
fix_scf <- !is.na(mun) & mun == "Santa Catarina" & num(d$Islands) == 3
add_log("1 municipality", "Santa Catarina recorded on Fogo -> Santa Catarina do Fogo", sum(fix_scf, na.rm = TRUE))
mun[fix_scf] <- "Santa Catarina do Fogo"
d$Municipality <- mun

expected_island <- c("Mosteiros" = 3, "Sao Filipe" = 3, "Santa Catarina do Fogo" = 3,
                     "Praia" = 7, "Ribeira Grande de Santiago" = 7, "Santa Catarina" = 7,
                     "Santa Cruz" = 7, "Sao Domingos" = 7, "Sao Lourenco dos Orgaos" = 7,
                     "Sao Miguel" = 7, "Sao Salvador do Mundo" = 7, "Tarrafal" = 7,
                     "Paul" = 8, "Porto Novo" = 8, "Ribeira Grande" = 8)
exp_i  <- unname(expected_island[strip_accents(d$Municipality)])
new_is <- ifelse(is.na(exp_i), num(d$Islands), exp_i)
add_log("1 island", "Islands code reset to match its municipality", sum(new_is != num(d$Islands), na.rm = TRUE))
d$Islands     <- new_is
d$island_name <- unname(c(`3` = "Fogo", `7` = "Santiago", `8` = "Santo Antao")[as.character(d$Islands)])
