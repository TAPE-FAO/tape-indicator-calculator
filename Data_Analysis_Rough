        sum(d$flag_id_prefix_mismatch, na.rm = TRUE))

# -----------------------------------------------------------------------------
# 2. Names
# -----------------------------------------------------------------------------
norm_name <- function(x) {
  x <- strip_accents(as.character(x))
  x <- tolower(trimws(x))
  x <- gsub("\\s+", " ", x)
  x <- gsub("\\s+(e|and|y)\\s+", " & ", x)
  x <- gsub("\\s*&\\s*", " & ", x)
  x
}
title_case <- function(x) gsub("(^|[ &])([a-z])", "\\1\\U\\2", x, perl = TRUE)

d$supervisor_raw <- d$supervisor
d$supervisor     <- title_case(norm_name(d$supervisor))
add_log("2 supervisor", "distinct labels before", length(unique(d$supervisor_raw)))
add_log("2 supervisor", "distinct labels after", length(unique(d$supervisor)))


# -----------------------------------------------------------------------------
# 3. Duplicate submissions
# -----------------------------------------------------------------------------
d$start_ts <- as.POSIXct(d$start, tz = "UTC", format = "%Y-%m-%d %H:%M:%OS")
d$dup_dropped <- 0L
dups <- which(num(d$flag_likely_duplicate) == 1)
review <- data.frame()
for (g in unique(d$questionnaire_ID[dups])) {
